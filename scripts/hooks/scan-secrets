#!/usr/bin/env bash
# Reads text on stdin. Exits 1 if it holds anything that works as a credential:
#   - a 48-character hex string, the size of every key and feed token; or
#   - a key or feed token from this machine's ~/.config/almanac/hosted-calendars.json.
# Never prints the secret it found.
set -u
text=$(cat)
if printf '%s\n' "$text" | grep -Eq '(^|[^0-9a-fA-F])[0-9a-f]{48}([^0-9a-fA-F]|$)'; then
  echo "blocked: a 48-character hex string (the size of a key or feed token) is in $1." >&2
  exit 1
fi
creds="$HOME/.config/almanac/hosted-calendars.json"
if [ -f "$creds" ]; then
  printf '%s' "$text" | python3 -c '
import json, re, sys
text = sys.stdin.read()
for c in json.load(open(sys.argv[1])):
    secrets = [c.get("key", "")]
    m = re.search(r"/feed/([^./]+)", c.get("subscribe", ""))
    if m:
        secrets.append(m.group(1))
    for s in secrets:
        if len(s) >= 16 and s in text:
            sys.exit(1)
' "$creds" || { echo "blocked: one of your almanac credentials is in $1." >&2; exit 1; }
fi
exit 0
