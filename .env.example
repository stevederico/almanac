HOST=127.0.0.1
PORT=18788
CAL_NAME=Almanac
DB_PATH=./data/calendar.db
FEED_TOKEN=
AGENT_KEY=
TLS_KEY=
TLS_CERT=
PUBLIC_BASE=
# Proxies in front that each append to X-Forwarded-For. Picks which entry is
# treated as the client for rate limiting. 0 ignores the header.
TRUSTED_PROXY_HOPS=1
# Tunable caps. Unset keeps the default shown.
MAX_CREATES_PER_CLIENT_HOUR=10
MAX_CREATES_PER_HOUR=2000
MAX_EVENTS_PER_CALENDAR=2000
MAX_TODOS_PER_CALENDAR=5000
MAX_NOTES_PER_CALENDAR=500
MAX_WRITES_PER_MINUTE=120
MAX_EXPORTS_PER_HOUR=10
# Database copies (VACUUM INTO) on a timer. Same volume by default, so also
# enable the host's volume backups. BACKUP_INTERVAL_HOURS=0 turns it off.
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=7
BACKUP_DIR=
# One-shot. Set to 1 for one boot to blank the legacy plaintext keys (keeps a
# .pre-0.11.0 copy). Ends rollback to builds older than 0.8.0.
SCRUB_LEGACY_KEYS=
